<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAN1.Views.RegisterPage"
             Title="RegisterPage">
    <VerticalStackLayout Padding="25" Spacing="15" VerticalOptions="Center">
        <Label Text="Реєстрація" FontSize="26" FontAttributes="Bold" HorizontalOptions="Center"/>
        <Entry x:Name="NameEntry" Placeholder="Ваше ім'я"/>
        <Entry x:Name="EmailEntry" Placeholder="Електронна пошта" Keyboard="Email"/>
        <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True"/>
        <Button Text="Увійти" HeightRequest="50" Clicked="RegisterButton_Clicked"/>
    </VerticalStackLayout>
</ContentPage>