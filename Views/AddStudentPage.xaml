<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MAN1.Views.AddStudentPage"
    Title="Новий учень">
    <VerticalStackLayout Padding="20" Spacing="15">
        <Label Text="Додати учня" FontSize="28" FontAttributes="Bold"/>
        <Entry x:Name="NameEntry" Placeholder="Ім'я учня"/>
        <Button Text="Додати" HeightRequest="50" Clicked="SaveButton_Clicked"/>
    </VerticalStackLayout>
</ContentPage>