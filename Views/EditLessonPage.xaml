<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MAN1.Views.EditLessonPage"
             Title="EditLessonPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label Text="Редагувати урок" FontSize="28" FontAttributes="Bold" />
            <Entry x:Name="StudentEntry" Placeholder="Ім'я учня" />
            <Entry x:Name="SubjectEntry" Placeholder="Предмет" />
            <DatePicker x:Name="LessonDatePicker" />
            <TimePicker x:Name="LessonTimePicker" />
            <Entry x:Name="DurationEntry" Placeholder="Тривалість в хвилинах" Keyboard="Numeric" />
            <Editor x:Name="CommentEditor" Placeholder="Коментар" />
            <Button Text="Зберегти зміни" Clicked="SaveButton_Clicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>