<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MAN1.Views.LessonsPage">

    <Grid RowDefinitions="*,Auto">
        <Grid Grid.Row="0" Padding="20" RowDefinitions="Auto,Auto,*" RowSpacing="10">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <Label Text="Заняття сьогодні" FontSize="28" FontAttributes="Bold" VerticalOptions="Center"/>
                <Button Grid.Column="1" Text="Учні" FontSize="16" Clicked="StudentsButton_Clicked"/>
            </Grid>
            <Label Grid.Row="1" Text="{Binding Lessons.Count, StringFormat='Кількість занять: {0}'}" FontSize="16"/>
            <CollectionView Grid.Row="2" ItemsSource="{Binding Lessons}" SelectionMode="Single" SelectionChanged="LessonSelectionChanged">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="1" Padding="15" Margin="0,5">
                            <Grid ColumnDefinitions="*,Auto">
                                <VerticalStackLayout Grid.Column="0" Spacing="5">
                                    <Label Text="{Binding Subject}" FontSize="20" FontAttributes="Bold"/>
                                    <Label Text="{Binding StudentName}" FontSize="16"/>
                                    <Label Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}" FontSize="14"/>
                                    <Label Text="{Binding StartTime, StringFormat='{0:hh\\:mm}'}" FontSize="14"/>
                                    <Label Text="{Binding Comment}" FontSize="14"/>
                                </VerticalStackLayout>
                                <Button
                                    Grid.Column="1"
                                    Text="✕"
                                    FontSize="18"
                                    WidthRequest="45"
                                    HeightRequest="45"
                                    CornerRadius="23"
                                    VerticalOptions="Center"
                                    CommandParameter="{Binding .}"
                                    Clicked="DeleteLessonButton_Clicked"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <Grid Grid.Row="1" Padding="20,8" ColumnDefinitions="*,*,*">
            <Button
                Grid.Column="0"
                Text="📅"
                FontSize="27"
                WidthRequest="65"
                HeightRequest="65"
                HorizontalOptions="Start"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                BorderWidth="0"
                TextColor="White"
                Clicked="CalendarButton_Clicked"/>

            <Button
                Grid.Column="1"
                Text="📊"
                FontSize="28"
                WidthRequest="65"
                HeightRequest="65"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="Transparent"
                BorderWidth="0"
                TextColor="White"
                Clicked="StatisticsButton_Clicked"/>

            <Button
                 Grid.Column="2"
                 Text="+"
                 FontSize="32"
                 WidthRequest="65"
                 HeightRequest="65"
                 HorizontalOptions="End"
                 VerticalOptions="Center"
                 BackgroundColor="Transparent"
                 BorderWidth="0"
                 TextColor="White"
                 Clicked="AddLessonButton_Clicked"/>

        </Grid>
    </Grid>
</ContentPage>