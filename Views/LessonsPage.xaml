<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MAN1.Views.LessonsPage"
    Title="Мої заняття">

    <Grid Padding="20">

        <Grid
            RowDefinitions="Auto,Auto,*"
            RowSpacing="10">

            <Label
                Grid.Row="0"
                Text="Мої заняття"
                FontSize="28"
                FontAttributes="Bold"/>

            <Label
                Grid.Row="1"
                Text="{Binding Lessons.Count, StringFormat='Кількість занять: {0}'}"
                FontSize="16"/>

            <CollectionView
                Grid.Row="2"
                ItemsSource="{Binding Lessons}">

                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border
                            StrokeThickness="1"
                            Padding="15"
                            Margin="0,5">

                            <VerticalStackLayout Spacing="5">

                                <Label
                                    Text="{Binding Subject}"
                                    FontSize="20"
                                    FontAttributes="Bold"/>

                                <Label
                                    Text="{Binding StudentName}"
                                    FontSize="16"/>

                                <Label
                                    Text="{Binding Date, StringFormat='{0:dd.MM.yyyy}'}"
                                    FontSize="14"/>

                                <Label
                                    Text="{Binding StartTime, StringFormat='{0:hh\\:mm}'}"
                                    FontSize="14"/>

                                <Label
                                    Text="{Binding Comment}"
                                    FontSize="14"/>

                            </VerticalStackLayout>

                        </Border>

                    </DataTemplate>
                </CollectionView.ItemTemplate>

            </CollectionView>

        </Grid>

        <Button
            Text="+"
            FontSize="32"
            WidthRequest="65"
            HeightRequest="65"
            CornerRadius="33"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,10,10"
            Clicked="AddLessonButton_Clicked"/>

    </Grid>

</ContentPage>